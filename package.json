{
  "name": "@nekosuneprojects/gaming-infos",
  "version": "3.0.0",
  "description": "Modular multi-game information SDK. Rebuilt from scratch with an independent Warframe provider powered by @nekosuneprojects/warframe-api.",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check src/registry.js && node --check src/providers/warframe.js",
    "prepack": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NekoSuneProjectsNPM/gaming-infos.git"
  },
  "bugs": {
    "url": "https://github.com/NekoSuneProjectsNPM/gaming-infos/issues"
  },
  "funding": "https://github.com/NekoSuneProjectsNPM/gaming-infos?sponsor",
  "keywords": [
    "gaming",
    "game-data",
    "modular",
    "warframe",
    "warframe-api",
    "worldstate",
    "redeem-codes"
  ],
  "author": "NekoSuneVR",
  "license": "MIT",
  "dependencies": {
    "@nekosuneprojects/warframe-api": "1.0.1"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
