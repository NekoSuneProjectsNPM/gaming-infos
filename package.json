{
  "name": "@nekosuneprojects/gaming-infos",
  "version": "3.0.2",
  "description": "Modular multi-game information SDK with independent Warframe, VRChat and Genshin Impact providers.",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check src/registry.js && node --check src/providers/warframe.js && node --check src/providers/vrchat.js && node --check src/providers/genshinimpact.js",
    "prepack": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NekoSuneProjectsNPM/gaming-infos.git"
  },
  "bugs": {
    "url": "https://github.com/NekoSuneProjectsNPM/gaming-infos/issues"
  },
  "funding": "https://github.com/NekoSuneProjectsNPM/gaming-infos?sponsor",
  "keywords": [
    "gaming",
    "game-data",
    "modular",
    "warframe",
    "warframe-api",
    "worldstate",
    "redeem-codes",
    "vrchat",
    "vrchat-api",
    "worlds",
    "groups",
    "avatars",
    "avatar-search",
    "genshin-impact",
    "genshinimpact-api",
    "enka-network",
    "genshin-codes"
  ],
  "author": "NekoSuneVR",
  "license": "MIT",
  "dependencies": {
    "@nekosuneprojects/warframe-api": "1.0.1",
    "@nekosuneprojects/vrchat-api": "1.0.0",
    "@nekosuneprojects/genshinimpact-api": "1.0.0"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
